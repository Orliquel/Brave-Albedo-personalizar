{
  "manifest_version": 3,
  "name": "Albedo Adaptativo · Controlador",
  "version": "0.4.2",
  "description": "Seleciona um tema nativo pela quantidade de abas e pela largura calibrada da janela.",
  "key": "",
  "permissions": [
    "management",
    "storage"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Albedo Adaptativo",
    "default_popup": "popup.html"
  }
}
